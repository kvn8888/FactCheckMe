VITE_API_URL=http://localhost:8787

# Server-side keys used by server/index.mjs
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_REALTIME_TRANSCRIPTION_MODEL=voxtral-mini-transcribe-realtime-2602
MISTRAL_REALTIME_DELAY_MS=1000
MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
MISTRAL_TTS_RESPONSE_FORMAT=mp3
# Provide either a saved Mistral voice id or a local reference audio file.
MISTRAL_TTS_REF_AUDIO_PATH=data/mistral-reference.aiff
# MISTRAL_TTS_VOICE_ID=your_saved_voice_id

# Gemini fact checking with native Google Search grounding
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# Optional overrides
PORT=8787
HOST=127.0.0.1
SQLITE_PATH=data/factcheckme.sqlite
