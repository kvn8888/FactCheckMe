# Server-only provider configuration. Never prefix credentials with VITE_.
MAI_TRANSCRIBE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
MAI_TRANSCRIBE_KEY=
MAI_TRANSCRIBE_MODEL=MAI-Transcribe-2
# AZURE_SPEECH_ENDPOINT / AZURE_SPEECH_KEY and MAI_TRANSCRIPTION_MODEL are accepted aliases.
OPENAI_API_KEY=
OPENAI_DECISIONS_MODEL=gpt-6-luna
OPENAI_MODEL=gpt-6-luna
EXA_API_KEY=
EXA_SEARCH_TYPE=lite

# Local/private password fallback. Generate these only after choosing this mode.
# APP_PASSWORD_HASH is scrypt$<32 hex salt>$<128 hex hash>.
APP_PASSWORD_HASH=
APP_SESSION_SECRET=
# Optional canonical origin; no trailing slash. Omit to use request host.
# APP_ORIGIN=http://localhost:8080

# Production alternative: Vercel Authentication for ALL deployments and domains.
# Set true ONLY AFTER verifying native protection. This is an owner assertion,
# not a setting that enables Vercel protection. Never disable platform protection
# while this flag is true. Requires Vercel's own VERCEL=1 runtime variable.
VERCEL_AUTH_PROTECTED=false
PORT=8787
HOST=127.0.0.1
